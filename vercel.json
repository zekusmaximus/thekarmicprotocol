{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path(.*)",
      "has": [
        {
          "type": "host",
          "value": "karmicprotocol.com"
        }
      ],
      "destination": "https://www.thekarmicprotocol.com/:path",
      "permanent": true
    },
    {
      "source": "/:path(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.karmicprotocol.com"
        }
      ],
      "destination": "https://www.thekarmicprotocol.com/:path",
      "permanent": true
    },
    {
      "source": "/experience",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/agent",
      "destination": "/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
